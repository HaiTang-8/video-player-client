{
  "categories": [
    {
      "title": "## 🚀 Features",
      "labels": ["feat", "feature"],
      "rules": [
        {"pattern": "^\\s*feat(\\(.+\\))?(!)?:"}
      ]
    },
    {
      "title": "## 🐛 Bug Fixes",
      "labels": ["fix", "bug"],
      "rules": [
        {"pattern": "^\\s*fix(\\(.+\\))?(!)?:"}
      ]
    },
    {
      "title": "## ♻️ Refactoring",
      "labels": ["refactor"],
      "rules": [
        {"pattern": "^\\s*refactor(\\(.+\\))?(!)?:"}
      ]
    },
    {
      "title": "## ⚡ Performance",
      "labels": ["perf"],
      "rules": [
        {"pattern": "^\\s*perf(\\(.+\\))?(!)?:"}
      ]
    },
    {
      "title": "## 📚 Documentation",
      "labels": ["docs", "documentation"],
      "rules": [
        {"pattern": "^\\s*docs(\\(.+\\))?(!)?:"}
      ]
    },
    {
      "title": "## 🎨 Styles",
      "labels": ["style", "ui"],
      "rules": [
        {"pattern": "^\\s*style(\\(.+\\))?(!)?:"}
      ]
    },
    {
      "title": "## 🧪 Tests",
      "labels": ["test"],
      "rules": [
        {"pattern": "^\\s*test(\\(.+\\))?(!)?:"}
      ]
    },
    {
      "title": "## 📦 Build & CI",
      "labels": ["build", "ci", "chore"],
      "rules": [
        {"pattern": "^\\s*(build|ci|chore)(\\(.+\\))?(!)?:"}
      ]
    },
    {
      "title": "## 📝 Other Changes",
      "labels": []
    }
  ],
  "ignore_labels": [
    "ignore"
  ],
  "sort": {
    "order": "ASC",
    "on_property": "date"
  },
  "template": "${{CHANGELOG}}",
  "pr_template": "- ${{TITLE}} @${{AUTHOR}}",
  "commit_template": "- ${{COMMIT_MESSAGE_BODY}} @${{COMMIT_AUTHOR}}",
  "empty_template": "- No changes found",
  "transformers": [
    {
      "pattern": "^\\s*(feat|fix|refactor|perf|docs|style|test|build|ci|chore)(\\(.+\\))?(!)?:\\s*",
      "target": ""
    }
  ]
}
